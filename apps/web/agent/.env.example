# Potpie user ID used by the in-process PotpieRuntime
POTPIE_USER_ID=defaultuser

# Port for the web agent server (agent/start.py auto-selects next free port if busy)
AGENT_PORT=8000

# LLM model string — overrides auto-detection from API keys
# Examples: anthropic:claude-sonnet-4-5  openai:gpt-4o  litellm:github_copilot/gpt-4o
PYDANTIC_DEEP_MODEL=

# Debug mode: set to true to enable uvicorn auto-reload
DEBUG=false
