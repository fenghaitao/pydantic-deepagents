# CGC project-local config for simics-c++-device
# This overrides ~/.codegraphcontext/.env for this project.
#
# Force SCIP language detection to cpp so scip-clang is used
# instead of scip-python (which wins the file-count race due to
# test scripts in modules/sample-device-c++/test/).
SCIP_INDEXER=true
SCIP_LANGUAGES=cpp

# Path to the scip-clang binary obtained via:
#   make setup-scip-clang          (download pre-built, default)
#   make setup-scip-clang-build    (build from source)
# Relative to this project directory (tests/integration-tests/sample-cpp/).
SCIP_CLANG_BIN=../../../code-graph-providers/scip-languages/bin/scip-clang
